---
import { Image } from 'astro:assets';
import DraftContentNotice from 'virtual:starlight/components/DraftContentNotice';
import { LinkButton } from '@astrojs/starlight/components';
import logoMarkUrl from '../assets/logo-mark.svg?url';
import logoMarkDarkUrl from '../assets/logo-mark-dark.svg?url';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, image, actions = [] } = data.hero || {};

let darkImage: ImageMetadata | undefined;
let lightImage: ImageMetadata | undefined;
let rawHtml: string | undefined;
if (image) {
	if ('file' in image) {
		darkImage = image.file;
	} else if ('dark' in image) {
		darkImage = image.dark;
		lightImage = image.light;
	} else {
		rawHtml = image.html;
	}
}
---

<div class="hero">
	{
		darkImage && (
			<Image
				src={darkImage}
				loading="eager"
				decoding="async"
				width={400}
				height={400}
				alt={image?.alt || ''}
				class:list={{ 'light:sl-hidden': Boolean(lightImage) }}
			/>
		)
	}
	{lightImage && <Image src={lightImage} loading="eager" decoding="async" width={400} height={400} alt={image?.alt || ''} class="dark:sl-hidden" />}
	{rawHtml && <div class="hero-html sl-flex" set:html={rawHtml} />}
	<div class="sl-flex stack">
		<div class="sl-flex copy">
			<div class="sl-flex title-row">
				<img src={logoMarkUrl} alt="" aria-hidden="true" class="title-logo dark:sl-hidden" />
				<img src={logoMarkDarkUrl} alt="" aria-hidden="true" class="title-logo light:sl-hidden" />
				<h1 id="_top" data-page-title set:html={title} />
			</div>
			{data.draft && <DraftContentNotice />}
			{tagline && <div class="tagline" set:html={tagline} />}
		</div>
		{
			actions.length > 0 && (
				<div class="sl-flex actions">
					{actions.map(
						({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
							<LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
								{text}
								{icon?.html && <Fragment set:html={icon.html} />}
							</LinkButton>
						)
					)}
				</div>
			)
		}
	</div>
</div>

<style>
	@layer starlight.core {
		.hero {
			display: grid;
			grid-template-columns: 100%;
			align-items: center;
			gap: 1rem;
			padding-bottom: 1rem;
			/* Drives the logo (via em), the wordmark and the tagline together so
			   the whole lockup scales as one unit. Stepped up for the wide-screen
			   lockup in the media query below. */
			--title-size: clamp(var(--sl-text-3xl), calc(0.25rem + 5vw), var(--sl-text-6xl));
		}

		.hero > img,
		.hero > .hero-html {
			object-fit: contain;
			width: min(70%, 20rem);
			height: auto;
			margin-inline: auto;
		}

		.stack {
			flex-direction: column;
			gap: clamp(1.5rem, calc(1.5rem + 1vw), 2rem);
			text-align: center;
		}

		.copy {
			flex-direction: column;
			gap: 1rem;
			align-items: center;
		}

		.copy > * {
			max-width: 50ch;
		}

		.title-row {
			align-items: center;
			gap: 1rem;
			/* set font-size so .title-logo can use em to match the h1 */
			font-size: var(--title-size);
		}

		.title-logo {
			/* The mark's ring spans the two-line wordmark: cap-top of "Open
			   Aviation" sits on the ring's top edge, the "Solutions" baseline on
			   its bottom edge. At the heading line-height (1.2) that span is
			   ~1.92em; the small top nudge re-centres for the font's larger
			   descent gap. Keep in step with scripts/generate-og-image.mjs. */
			height: 1.92em;
			width: auto;
			flex-shrink: 0;
			margin-top: 0.03em;
		}

		.title-row h1 {
			margin-block: 0;
			/* Keep the wordmark's two lines aligned to each other ("Solutions"
			   under "Open Aviation") even where the hero is otherwise centred,
			   e.g. on narrow screens. */
			text-align: start;
		}

		/* Force the wordmark to stack ("Open Aviation" / "Solutions") regardless
		   of column width, so the lockup matches the social card and the tagline
		   can be width-matched to it. The accent span carries "Solutions". */
		.title-row h1 :global(span) {
			display: block;
		}

		h1 {
			font-size: var(--title-size);
			line-height: var(--sl-line-height-headings);
			font-weight: 600;
			color: var(--sl-color-white);
		}

		.tagline {
			font-size: clamp(var(--sl-text-base), calc(0.0625rem + 2vw), var(--sl-text-xl));
			color: var(--sl-color-gray-2);
		}

		.actions {
			gap: 1rem 2rem;
			flex-wrap: wrap;
			justify-content: center;
		}

		@media (min-width: 50rem) {
			.hero {
				grid-template-columns: 7fr 4fr;
				gap: 3%;
				padding-block: clamp(2.5rem, calc(1rem + 10vmin), 10rem);
				/* Larger lockup so the width-matched tagline lands around 18px. */
				--title-size: clamp(4.25rem, calc(2rem + 3vw), 5rem);
			}

			.hero > img,
			.hero > .hero-html {
				order: 2;
				width: min(100%, 25rem);
			}

			.stack {
				text-align: start;
			}

			.copy {
				align-items: flex-start;
			}

			.title-row {
				gap: 0.3em;
			}

			/* One line spanning the lockup's left edge to the wordmark's right
			   edge. Both strings are fixed, so their widths scale linearly with
			   font size: tagline = 0.254 x title holds the match at every width.
			   Keep the 0.254 ratio in step with scripts/generate-og-image.mjs. */
			.tagline {
				font-size: calc(0.254 * var(--title-size));
				max-width: none;
				white-space: nowrap;
			}

			.actions {
				justify-content: flex-start;
			}
		}
	}
</style>
